# Core service metadata
APP_NAME=Invoice Extractor API
APP_VERSION=1.1.0
APP_ENV=production
LOG_LEVEL=INFO

# Authentication
DIRECT_API_ACCESS_ENABLED=false
API_KEY=
REQUIRE_RAPIDAPI_SECRET=true
RAPIDAPI_PROXY_SECRET=

# Upload and extraction limits
MAX_FILE_SIZE_MB=5
MAX_PDF_PAGES=5
MAX_IMAGE_PIXELS=25000000
MAX_EXTRACTED_TEXT_LENGTH=200000
MAX_LINE_ITEMS=50

# OCR
ENABLE_OCR=true
OCR_LANGUAGES=eng+ara+fra+ita+hin
OCR_TIMEOUT_SECONDS=25
MAX_CONCURRENT_OCR_JOBS=2

# Request lifecycle
REQUEST_TIMEOUT_SECONDS=35

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_HEADERS=true

# Network and docs
CORS_ALLOWED_ORIGINS=
EXPOSE_DOCS=true
INCLUDE_RAW_TEXT=false

# Optional transport security
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000
